# =============================================================================
# Synesthesia Backend – Environment Variables (EXAMPLE ONLY – DO NOT ADD REAL VALUES)
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# =============================================================================

# ----- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ----- ML Model --------------------------------------------------------------
MODEL_PATH=models/best_model.pt
SCALER_PATH=models/scaler.pkl
LABEL_ENCODER_PATH=models/label_encoder.pkl
MODEL_TYPE=cnn          # Options: cnn | xgboost | random_forest | svm

# ----- LLM (for AI insights & compliments) -----------------------------------
# Provide EITHER OpenAI OR Anthropic – not both required.
LLM_PROVIDER=openai     # Options: openai | anthropic | mock
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ----- File Upload -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,flac,ogg
TEMP_UPLOAD_DIR=tmp/uploads

# ----- CORS ------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
